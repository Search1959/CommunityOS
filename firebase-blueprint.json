{
  "entities": {
    "user_credentials": {
      "title": "User Credentials & Logins",
      "description": "Multi-tenant role-based user authentication logins and credentials",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "username": { "type": "string" },
        "passwordHash": { "type": "string" },
        "role": { "type": "string" },
        "orgId": { "type": "string" },
        "orgName": { "type": "string" },
        "status": { "type": "string" },
        "hierarchyLevel": { "type": "number" },
        "lastLogin": { "type": "string" },
        "createdAt": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["id", "username", "passwordHash", "role"]
    },
    "donations": {
      "title": "Donations",
      "description": "80G and general community donations",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "donorName": { "type": "string" },
        "donorPhone": { "type": "string" },
        "donorPan": { "type": "string" },
        "amount": { "type": "number" },
        "purpose": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "date": { "type": "string" },
        "receiptNo": { "type": "string" },
        "is80G": { "type": "boolean" },
        "cert80GUrl": { "type": "string" }
      },
      "required": ["id", "donorName", "amount", "date"]
    },
    "applications": {
      "title": "Welfare Applications",
      "description": "Scholarship and medical aid applications",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "applicantName": { "type": "string" },
        "schemeId": { "type": "string" },
        "schemeName": { "type": "string" },
        "amountRequested": { "type": "number" },
        "appliedDate": { "type": "string" },
        "status": { "type": "string" },
        "applicantPhone": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "applicantName", "schemeName", "status"]
    },
    "members": {
      "title": "Community Members",
      "description": "Registered community members",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "membershipType": { "type": "string" },
        "joinedDate": { "type": "string" },
        "isVerified": { "type": "boolean" }
      },
      "required": ["id", "fullName", "phone"]
    },
    "schemes": {
      "title": "Welfare Schemes",
      "description": "Community assistance and scholarship schemes",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "budget": { "type": "number" },
        "disbursed": { "type": "number" },
        "beneficiariesCount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "title", "category"]
    },
    "meetings": {
      "title": "Committee Meetings",
      "description": "Executive and AGM committee meeting records",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "venue": { "type": "string" },
        "agenda": { "type": "string" },
        "minutes": { "type": "string" },
        "attendeesCount": { "type": "number" }
      },
      "required": ["id", "title", "date"]
    },
    "events": {
      "title": "Community Events",
      "description": "Festivals, medical camps, and community assemblies",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "venue": { "type": "string" },
        "description": { "type": "string" },
        "attendeeCount": { "type": "number" }
      },
      "required": ["id", "title", "date"]
    },
    "vault_documents": {
      "title": "Document Vault",
      "description": "Uploaded statutory and audit documents",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "uploadDate": { "type": "string" },
        "fileType": { "type": "string" },
        "fileSize": { "type": "string" },
        "fileUrl": { "type": "string" },
        "ocrSummary": { "type": "string" }
      },
      "required": ["id", "title", "category"]
    },
    "audit_reports": {
      "title": "Audit Reports",
      "description": "Annual financial audit and statutory compliance records",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "financialYear": { "type": "string" },
        "auditorName": { "type": "string" },
        "totalIncome": { "type": "number" },
        "totalExpense": { "type": "number" },
        "surplus": { "type": "number" },
        "fileUrl": { "type": "string" }
      },
      "required": ["id", "financialYear"]
    },
    "organizations": {
      "title": "SaaS Community Organizations",
      "description": "Multi-tenant registered organizations",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "regNo": { "type": "string" },
        "tagline": { "type": "string" },
        "location": { "type": "string" },
        "membersCount": { "type": "number" },
        "totalDonationsYTD": { "type": "number" },
        "activeSchemesCount": { "type": "number" },
        "themeColor": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "finance_transactions": {
      "title": "Finance Transactions",
      "description": "Income and expenditure entries",
      "properties": {
        "id": { "type": "string" },
        "orgId": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "date": { "type": "string" },
        "approvedBy": { "type": "string" },
        "voucherNo": { "type": "string" }
      },
      "required": ["id", "type", "amount", "date"]
    }
  },
  "firestore": {
    "/userCredentials/{credentialId}": {
      "schema": "user_credentials",
      "description": "Role-based user login credentials and hierarchy levels"
    },
    "/organizations/{orgId}": {
      "schema": "organizations",
      "description": "Multi-tenant organizations and community trusts"
    },
    "/members/{memberId}": {
      "schema": "members",
      "description": "Registered community members"
    },
    "/donations/{donationId}": {
      "schema": "donations",
      "description": "Donations with 80G tax certificates"
    },
    "/applications/{appId}": {
      "schema": "applications",
      "description": "Welfare and scholarship applications"
    },
    "/schemes/{schemeId}": {
      "schema": "schemes",
      "description": "Active community welfare schemes"
    },
    "/meetings/{meetingId}": {
      "schema": "meetings",
      "description": "Executive committee and AGM meeting proceedings"
    },
    "/events/{eventId}": {
      "schema": "events",
      "description": "Community events and festival programs"
    },
    "/transactions/{txId}": {
      "schema": "finance_transactions",
      "description": "Financial ledger transactions and vouchers"
    },
    "/vaultDocs/{docId}": {
      "schema": "vault_documents",
      "description": "Document vault with AI OCR extractions"
    },
    "/auditReports/{reportId}": {
      "schema": "audit_reports",
      "description": "Audited accounts and statutory compliance reports"
    }
  }
}
